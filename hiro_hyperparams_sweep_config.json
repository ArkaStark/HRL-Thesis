{
    "method": "bayes",
    "metric": {
        "name": "mean_episode_return",
        "goal": "maximize"
    },
    "parameters": {
        "EXPL_NOISE_MANAGER": {
            "distribution": "uniform",
            "min": 0.01,
            "max": 3
        },
        "EXPL_NOISE_WORKER": {
            "distribution": "uniform",
            "min": 0.01,
            "max": 3
        },
        "SUBGOAL_HORIZON": {
            "values": [
                2,
                5,
                10
            ]
        },
        "GOAL_BOUND": {
            "distribution": "uniform",
            "min": 0.05,
            "max": 2.0
        }
    }
}