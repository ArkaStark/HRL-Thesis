{
    "method": "bayes",
    "metric": {
        "name": "mean_episode_return",
        "goal": "maximize"
    },
    "parameters": {
        "ENT_COEF": {
            "distribution": "log_uniform_values",
            "min": 0.0001,
            "max": 0.01
        },
        "LR_ACTOR": {
            "distribution": "log_uniform_values",
            "min": 1e-04,
            "max": 3e-3
        },
        "LR_CRITIC": {
            "distribution": "log_uniform_values",
            "min": 1e-3,
            "max": 0.01
        },
        "LAM": {
            "distribution": "uniform",
            "min": 0.9,
            "max": 0.99
        },
        "PPO_EPOCHS": {
            "values": [
                2,
                4,
                8
            ]
        }
    }
}