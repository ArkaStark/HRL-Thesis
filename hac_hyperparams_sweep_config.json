{
    "method": "bayes",
    "metric": {
        "name": "mean_episode_return",
        "goal": "maximize"
    },
    "parameters": {
        "EXPL_NOISE_MANAGER": {
            "distribution": "uniform",
            "min": 1e-2,
            "max": 3
        },
        "EXPL_NOISE_WORKER": {
            "distribution": "uniform",
            "min": 1e-2,
            "max": 3
        },
        "SUBGOAL_HORIZON": {
            "values": [
                5,
                10
            ]
        },
        "GOAL_BOUND": {
            "distribution": "log_uniform_values",
            "min": 0.01,
            "max": 3.0
        },
        "GOAL_THRESHOLD": {
            "distribution": "log_uniform_values",
            "min": 0.001,
            "max": 1.0
        },
        "SUBGOAL_TEST_FREQ": {
            "distribution": "uniform",
            "min": 0.1,
            "max": 0.9
        }
    }
}