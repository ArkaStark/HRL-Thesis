{
    "method": "bayes",
    "metric": {
        "name": "mean_episode_return",
        "goal": "maximize"
    },
    "parameters": {
        "EXPL_NOISE_MANAGER": {
            "distribution": "uniform",
            "min": 0.5,
            "max": 2.5
        },
        "EXPL_NOISE_WORKER": {
            "distribution": "uniform",
            "min": 0.05,
            "max": 0.25
        },
        "SUBGOAL_HORIZON": {
            "values": [
                2,
                5,
                10
            ]
        },
        "GOAL_BOUND": {
            "distribution": "uniform",
            "min": 0.5,
            "max": 2.5
        },
        "GOAL_THRESHOLD": {
            "distribution": "uniform",
            "min": 0.1,
            "max": 2.0
        },
        "SUBGOAL_TEST_FREQ": {
            "distribution": "uniform",
            "min": 0.1,
            "max": 0.9
        },
        "ALPHA": {
            "distribution": "log_uniform_values",
            "min": 0.001,
            "max": 1
        }
    }
}