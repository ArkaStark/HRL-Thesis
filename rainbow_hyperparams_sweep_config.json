{
    "method": "bayes",
    "metric": {
        "name": "mean_episode_return",
        "goal": "maximize"
    },
    "parameters": {
        "LR": {
            "distribution": "log_uniform_values",
            "min": 1e-05,
            "max": 0.01
        },
        "N_STEP": {
            "values": [
                1,
                2,
                5, 
                10
            ]
        },
        "ATOM_SIZE": {
            "values": [
                2,
                3,
                4,
                8
            ]
        },
        "V_MAX": {
            "values": [
                100.0,
                200.0,
                300.0
            ]
        },
        "ALPHA": {
            "distribution": "uniform",
            "min": 0.1,
            "max": 0.9
        }
    }
}